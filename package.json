{
  "name": "n8n-nodes-whatsapp-advanced",
  "version": "1.0.0",
  "description": "Advanced WhatsApp Business node for n8n: template-aware variable fields, Cloud API and Marketing Messages API endpoint routing, and full Meta error-code handling with delivery-status parsing.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whatsapp",
    "whatsapp-business",
    "whatsapp-cloud-api",
    "marketing-messages-api",
    "meta",
    "graph-api",
    "message-templates",
    "mm-lite"
  ],
  "license": "MIT",
  "homepage": "https://github.com/AakashKhambhaliya/n8n-nodes-whatsapp-advanced#readme",
  "author": {
    "name": "Aakash Khambhaliya",
    "url": "https://github.com/AakashKhambhaliya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AakashKhambhaliya/n8n-nodes-whatsapp-advanced.git"
  },
  "bugs": {
    "url": "https://github.com/AakashKhambhaliya/n8n-nodes-whatsapp-advanced/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist .tsbuildinfo && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "test": "npm run build && node test/templates.test.js && node test/errors.test.js && node test/webhook.test.js && node test/routing.test.js && node test/security.test.js",
    "prepublishOnly": "npm run build && npm run lint && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WhatsAppAdvancedApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WhatsAppAdvanced/WhatsAppAdvanced.node.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
